# Goemon64Recomp-NX patch on klorfmorf/N64ModernRuntime @ goemon-patches
# (fc4592a31414daf0040c19907e0b1976b2e48a67)
# Applied by scripts/build-nro.sh (idempotent: reverse --check then apply --check).
#
#   error_handling.cpp: std::_Exit on __SWITCH__ (no std::quick_exit)
#   events.cpp: coalesce stale ScreenUpdateActions so GLideN64 vsync present
#               cannot starve display lists (DK64-NX "freeze on the Nintendo logo");
#               VI thread waits on display vsync (goemon64nx_wait_vsync) on Switch
#   files.cpp: Switch save rotation via rename+remove (libstdc++ copy_file
#              ends in fchmod, which the libnx SD driver rejects with ENOSYS)
#   pi.cpp: save init/read/write logs; flush save on saving-thread exit
#   pak.cpp: osPfsReadWriteFile logs (first 4 + every 30)
#
diff --git a/librecomp/src/files.cpp b/librecomp/src/files.cpp
index af6f18d..b94dc31 100644
--- a/librecomp/src/files.cpp
+++ b/librecomp/src/files.cpp
@@ -36,6 +36,19 @@ bool recomp::finalize_output_file_with_backup(const std::filesystem::path& filep
     temp_path += temp_suffix;
 
     std::error_code ec;
+#ifdef __SWITCH__
+    // libstdc++'s copy_file ends with fchmod, which libnx's SD driver rejects (ENOSYS), so every
+    // copy fails. Rotate with renames instead; FAT renames refuse an existing target, hence the removes.
+    std::filesystem::remove(backup_path, ec);
+    if (std::filesystem::exists(filepath, ec)) {
+        std::filesystem::rename(filepath, backup_path, ec);
+        if (ec) {
+            return false;
+        }
+    }
+    std::filesystem::rename(temp_path, filepath, ec);
+    return !ec;
+#else
     if (std::filesystem::exists(filepath, ec)) {
         std::filesystem::copy_file(filepath, backup_path, std::filesystem::copy_options::overwrite_existing, ec);
         if (ec) {
@@ -48,4 +61,5 @@ bool recomp::finalize_output_file_with_backup(const std::filesystem::path& filep
     }
     std::filesystem::remove(temp_path, ec);
     return true;
+#endif
 }
