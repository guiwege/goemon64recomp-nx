diff --git a/ultramodern/src/events.cpp b/ultramodern/src/events.cpp
index 1cd7907..a24fb26 100644
--- a/ultramodern/src/events.cpp
+++ b/ultramodern/src/events.cpp
@@ -133,6 +133,17 @@ static struct {
     moodycamel::ConcurrentQueue<OSThread*> deleted_threads{};
 } events_context{};
 
+// GLideN64 presents on the gfx thread and blocks on vsync. Screen updates then
+// pile up behind a slow ProcessDList (shader compile) and starve later gfx
+// tasks — DK64-NX "freeze on the Nintendo logo". Drop a screen update when a
+// newer one is already queued; always present the latest.
+static std::atomic_int pending_screen_updates{0};
+
+extern "C" void nx_log(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+#ifdef __SWITCH__
+extern "C" bool goemon64nx_wait_vsync();
+#endif
+
 ultramodern::renderer::ViRegs* ultramodern::renderer::get_vi_regs() {
     return &events_context.vi.update_screen_regs;
 }
@@ -200,7 +211,13 @@ void vi_thread_func() {
             // printf("Skipping the next VI wait\n");
             next = std::chrono::high_resolution_clock::now();
         }
+#ifdef __SWITCH__
+        if (!goemon64nx_wait_vsync()) {
+            ultramodern::sleep_until(next);
+        }
+#else
         ultramodern::sleep_until(next);
+#endif
         auto time_now = ultramodern::time_since_start();
         // Calculate how many VIs have passed
         uint64_t new_total_vis = (time_now * (60 * ultramodern::get_speed_multiplier()) / 1000ms) + 1;
@@ -218,6 +235,7 @@ void vi_thread_func() {
 
         // Queue a screen update for the graphics thread with the current VI register state.
         // Doing this before the VI update is equivalent to updating the screen after the previous frame's scanout finished.
+        pending_screen_updates.fetch_add(1);
         events_context.action_queue.enqueue(ScreenUpdateAction{ events_context.vi.regs });
 
         // Update VI registers and swap VI modes.
@@ -380,6 +398,16 @@ void gfx_thread_func(uint8_t* rdram, moodycamel::LightweightSemaphore* thread_re
             }
             else if (const auto* screen_update_action = std::get_if<ScreenUpdateAction>(&action)) {
                 events_context.vi.update_screen_regs = screen_update_action->regs;
+                // fetch_sub returns the previous count. >1 means a newer update is
+                // already queued — skip the present so gfx tasks can drain.
+                if (pending_screen_updates.fetch_sub(1) > 1) {
+                    static bool logged_skip = false;
+                    if (!logged_skip) {
+                        logged_skip = true;
+                        nx_log("gfx queue: coalescing stale screen updates");
+                    }
+                    continue;
+                }
                 renderer_context->update_screen();
                 display_refresh_rate = renderer_context->get_display_framerate();
                 resolution_scale = renderer_context->get_resolution_scale();
